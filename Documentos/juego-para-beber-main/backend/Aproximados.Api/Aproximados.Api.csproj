<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Aproximados.Api</RootNamespace>
    <AssemblyName>Aproximados.Api</AssemblyName>
  </PropertyGroup>



  <!--
    Tests/ usa xunit, que no es dependencia de la API. Compilarlos aquí rompía
    `dotnet build` del proyecto web; viven fuera de la compilación hasta que
    tengan su propio proyecto de test.
  -->
  <ItemGroup>
    <Compile Remove="Tests/**/*.cs" />
    <Content Remove="Tests/**" />
    <None Remove="Tests/**" />
  </ItemGroup>

</Project>
