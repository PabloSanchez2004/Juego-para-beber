<StackPane xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Ventana.ControladorVentanaLogin">
   <children>
      <VBox alignment="CENTER" spacing="10">
